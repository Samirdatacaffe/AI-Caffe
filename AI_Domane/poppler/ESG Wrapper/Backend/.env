# ── Ollama Cloud (LLM) ─────────────────────────────────
OLLAMA_API_KEY=598cf8ded80c41838eb5c091db826392.5IBNbLj1reHLWIJYfH-Cudhj
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_LLM_MODEL=kimi-k2.5

# ── OpenAI (optional — GPT will use Ollama Cloud if this is not set)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── Anthropic (optional — Sonnet 4.6 will use Ollama Cloud if this is not set)
# ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings (local nomic-embed-text — no API key needed)
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# ── Redis (optional — app falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379

# ── RAG tuning ─────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVER_K=5

# ── Memory ─────────────────────────────────────────────
MEMORY_MAX_MESSAGES=10
